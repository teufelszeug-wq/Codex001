    "phaser": "3.90.0",
    "rot-js": "2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "vite": "6.4.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
